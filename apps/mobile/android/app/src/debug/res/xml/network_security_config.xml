<?xml version="1.0" encoding="utf-8"?>
<!--
  يسمح بـ HTTP غير المشفّر لخوادم التطوير المحلية فقط.

  هذا الملف تحت src/debug فلا يدخل بناء الإصدار إطلاقاً: النسخة التي تصل
  المكلفين تبقى محكومة بمنع الاتصال غير المشفّر افتراضياً.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- مع adb reverse: منفذ الجهاز يُمرَّر إلى جهاز التطوير. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- مضيف جهاز التطوير كما يراه محاكي أندرويد. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
