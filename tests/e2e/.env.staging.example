# Non-secret staging E2E isolation contract.
# Copy to an ignored local file and inject secrets through the runner secret store.

E2E_TARGET=staging
E2E_DATASET=synthetic
E2E_CONFIRM_NO_PRODUCTION_WRITES=true
E2E_CONFIRM_SYNTHETIC_TAXPAYERS_ONLY=true

E2E_WEB_BASE_URL=https://staging.example.invalid
E2E_API_BASE_URL=https://api.staging.example.invalid
E2E_STAGING_SUPABASE_URL=https://staging-project-ref.supabase.co
E2E_STAGING_PROJECT_REF=
E2E_PRODUCTION_PROJECT_REF=
E2E_PRODUCTION_WEB_URL=https://production.example.invalid
E2E_PRODUCTION_API_URL=https://api.production.example.invalid

E2E_STORAGE_BUCKET=taxpayer-documents
E2E_OTP_MODE=fixed_test_code
E2E_SMS_ADAPTER=fake
E2E_PUSH_ADAPTER=test
E2E_FCM_PROJECT_ID=
