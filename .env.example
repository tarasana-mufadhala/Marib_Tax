# Marib Tax System — environment variable placeholders
# Copy to .env locally. Never commit real values.
# PUBLIC_ / NEXT_PUBLIC_ = safe for client bundles when intentionally exposed.
# All other variables are SERVER-ONLY secrets or configuration.

# =============================================================================
# Application
# =============================================================================
APP_NAME=
APP_ENV=development
APP_URL=
API_URL=
WEB_URL=
LOG_LEVEL=info
PORT=

# Public client variables (intentionally exposable)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
PUBLIC_APP_NAME=

# =============================================================================
# Database / Supabase
# =============================================================================
# SERVER-ONLY
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_JWT_SECRET=

# Public client variables (anon key only when required by approved client SDK usage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Authentication
# =============================================================================
# SERVER-ONLY
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL=
AUTH_REFRESH_TOKEN_TTL=
SESSION_SECRET=

# =============================================================================
# Storage
# =============================================================================
# SERVER-ONLY
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=

# =============================================================================
# Twilio
# =============================================================================
# SERVER-ONLY
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# =============================================================================
# Firebase
# =============================================================================
# SERVER-ONLY
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=
# Client (public) Firebase web config placeholders — no private keys
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# =============================================================================
# Observability
# =============================================================================
# SERVER-ONLY
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
METRICS_ENABLED=
