{
  "name": "marib-tax",
  "private": true,
  "description": "Marib Tax System monorepo — repository foundation only; no runtime application dependencies.",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "validate:foundation": "bash scripts/validate-foundation.sh",
    "test:e2e:preflight": "bash scripts/test/staging-e2e-preflight.sh",
    "test:e2e:api": "pnpm --filter @marib-tax/api test:e2e",
    "test:e2e:web:http": "bash scripts/test/web-http-e2e.sh",
    "test:e2e:web": "playwright test --config tests/e2e/web/playwright.config.ts",
    "test:e2e:local": "pnpm test:e2e:api && pnpm test:e2e:web:http",
    "validate:openapi": "redocly lint --config redocly.yaml packages/contracts/openapi/marib-tax.v1.yaml",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tests/e2e/web/tsconfig.json --noEmit",
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @marib-tax/contracts build && pnpm -r --if-present test",
    "lint": "eslint apps/api/src apps/api/test packages/contracts/src packages/contracts/test tests/e2e/web/*.ts --max-warnings=0 && pnpm --filter @marib-tax/web lint && pnpm --filter @marib-tax/worker lint",
    "format:check": "prettier --check \"{apps,packages,tests}/**/*.{ts,cjs,json,yaml}\""
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@eslint/js": "9.39.5",
    "@redocly/cli": "2.39.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
