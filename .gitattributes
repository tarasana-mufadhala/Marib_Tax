# Normalize line endings
* text=auto eol=lf

# Source and configuration — enforce LF
*.cjs text eol=lf
*.css text eol=lf
*.dart text eol=lf
*.editorconfig text eol=lf
*.env.example text eol=lf
*.gradle text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.mdc text eol=lf
*.mjs text eol=lf
*.properties text eol=lf
*.scss text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Shell scripts executable bit hint (Unix checkouts)
*.sh text eol=lf

# Binary documents
*.doc binary
*.docx binary
*.odt binary
*.pdf binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary

